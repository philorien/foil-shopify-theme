{%- comment -%}
  Product card snippet — full TCG version.
  Accepts:
    product        (required) — product object
    show_quick_add (optional, default: true) — show quick-add button
  Usage: {% render 'card-product', product: product %}
{%- endcomment -%}

{%- if product != blank -%}
  {%- liquid
    assign show_quick_add = show_quick_add | default: true
    assign current_variant = product.selected_or_first_available_variant
    assign condition = product.metafields.tcg.condition.value
    assign set_name = product.metafields.tcg.set_name.value
    assign rarity = product.metafields.tcg.rarity.value
    assign is_foil = false
    if current_variant.title contains 'Foil'
      assign is_foil = true
    endif
    assign inventory = current_variant.inventory_quantity
    assign low_stock = settings.low_stock_threshold
  -%}

  <div class="group bg-surface border border-border rounded overflow-hidden hover:border-primary transition-colors relative">
    {%- comment -%} Image block with overlays {%- endcomment -%}
    <a href="{{ product.url }}" class="block relative">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 400 }}"
          srcset="
            {{ product.featured_image | image_url: width: 200 }} 200w,
            {{ product.featured_image | image_url: width: 400 }} 400w,
            {{ product.featured_image | image_url: width: 600 }} 600w
          "
          sizes="(min-width: 1024px) 20vw, (min-width: 640px) 33vw, 50vw"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="400"
          height="560"
          class="w-full card-aspect object-cover{% if settings.enable_foil_shimmer and is_foil %} foil-shimmer{% endif %}"
          loading="lazy"
        >
      {%- else -%}
        <div class="w-full card-aspect bg-background flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-border" aria-hidden="true">
            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
            <circle cx="9" cy="9" r="2"/>
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
          </svg>
        </div>
      {%- endif -%}

      {%- comment -%} Badge overlays {%- endcomment -%}
      <div class="absolute top-2 left-2 flex flex-col gap-1">
        {%- if settings.show_condition_badge and condition != blank -%}
          {%- liquid
            assign condition_class = 'badge'
            assign condition_lower = condition | downcase
            if condition_lower == 'nm' or condition_lower == 'near mint'
              assign condition_class = 'badge badge-success'
            elsif condition_lower == 'lp' or condition_lower == 'lightly played'
              assign condition_class = 'badge badge-primary'
            elsif condition_lower == 'mp' or condition_lower == 'moderately played'
              assign condition_class = 'badge badge-accent'
            elsif condition_lower == 'hp' or condition_lower == 'heavily played'
              assign condition_class = 'badge badge-error'
            elsif condition_lower == 'd' or condition_lower == 'damaged'
              assign condition_class = 'badge badge-error'
            endif
          -%}
          <span class="{{ condition_class }}">{{ condition }}</span>
        {%- endif -%}

        {%- if settings.show_set_badge and set_name != blank -%}
          <span class="badge">{{ set_name }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Rarity indicator {%- endcomment -%}
      {%- if settings.show_rarity_indicator and rarity != blank -%}
        {%- liquid
          assign rarity_color = 'bg-border'
          assign rarity_lower = rarity | downcase
          if rarity_lower == 'common'
            assign rarity_color = 'bg-text'
          elsif rarity_lower == 'uncommon'
            assign rarity_color = 'bg-[#c0c0c0]'
          elsif rarity_lower == 'rare'
            assign rarity_color = 'bg-accent'
          elsif rarity_lower == 'mythic' or rarity_lower == 'mythic rare' or rarity_lower == 'ultra rare' or rarity_lower == 'secret rare'
            assign rarity_color = 'bg-error'
          endif
        -%}
        <span
          class="absolute top-2 right-2 w-3 h-3 rounded-full {{ rarity_color }} border border-white/30"
          title="{{ rarity }}"
          aria-label="{{ rarity }}"
        ></span>
      {%- endif -%}

      {%- comment -%} Sale badge {%- endcomment -%}
      {%- if product.compare_at_price > product.price -%}
        <span class="absolute bottom-2 left-2 badge badge-error">{{ 'products.sale' | t }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Card info {%- endcomment -%}
    <div class="p-3">
      <a href="{{ product.url }}" class="block">
        <h3 class="text-sm font-bold text-text group-hover:text-primary transition-colors line-clamp-2 mb-1">
          {{ product.title }}
        </h3>
      </a>

      {%- comment -%} Price {%- endcomment -%}
      <div class="flex items-baseline gap-2 mb-2">
        <span class="text-sm font-bold text-primary">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="text-xs text-text line-through opacity-40">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Stock status {%- endcomment -%}
      {%- if product.available -%}
        {%- if low_stock > 0 and inventory > 0 and inventory <= low_stock -%}
          <p class="text-xs text-accent font-bold mb-2">
            {{ 'products.low_stock' | t: count: inventory }}
          </p>
        {%- endif -%}
      {%- else -%}
        <p class="text-xs text-error font-bold mb-2">{{ 'products.sold_out' | t }}</p>
      {%- endif -%}

      {%- comment -%} Quick add / Choose options {%- endcomment -%}
      {%- if show_quick_add -%}
        {%- if product.available -%}
          {%- if product.variants.size == 1 -%}
            <button
              type="button"
              class="btn btn-primary btn-sm w-full"
              data-quick-add
              data-variant-id="{{ current_variant.id }}"
              aria-label="{{ 'products.add_to_cart' | t }}: {{ product.title | escape }}"
            >
              {{ 'products.add_to_cart' | t }}
            </button>
          {%- else -%}
            <a
              href="{{ product.url }}"
              class="btn btn-secondary btn-sm w-full"
            >
              {{ 'products.variant' | t }}
            </a>
          {%- endif -%}
        {%- else -%}
          <button type="button" class="btn btn-secondary btn-sm w-full opacity-50" disabled>
            {{ 'products.sold_out' | t }}
          </button>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
