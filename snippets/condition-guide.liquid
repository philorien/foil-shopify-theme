{%- comment -%}
  Condition guide snippet — renders a reference table of TCG card conditions.
  Can be displayed standalone or wrapped in a modal by the condition-guide modal JS.
  Usage: {% render 'condition-guide' %}
{%- endcomment -%}

<div class="condition-guide" data-condition-guide>
  <h3 class="text-lg font-heading font-bold text-text mb-4">{{ 'conditions.guide_title' | t }}</h3>
  <dl class="space-y-3">
    <div class="flex gap-3 p-3 bg-background rounded">
      <dt class="flex-shrink-0 w-10">
        <span class="badge badge-success">{{ 'conditions.nm_abbr' | t }}</span>
      </dt>
      <dd>
        <p class="text-sm font-bold text-text">{{ 'conditions.nm' | t }}</p>
        <p class="text-xs text-text opacity-60 mt-0.5">{{ 'conditions.nm_desc' | t }}</p>
      </dd>
    </div>
    <div class="flex gap-3 p-3 bg-background rounded">
      <dt class="flex-shrink-0 w-10">
        <span class="badge badge-primary">{{ 'conditions.lp_abbr' | t }}</span>
      </dt>
      <dd>
        <p class="text-sm font-bold text-text">{{ 'conditions.lp' | t }}</p>
        <p class="text-xs text-text opacity-60 mt-0.5">{{ 'conditions.lp_desc' | t }}</p>
      </dd>
    </div>
    <div class="flex gap-3 p-3 bg-background rounded">
      <dt class="flex-shrink-0 w-10">
        <span class="badge badge-accent">{{ 'conditions.mp_abbr' | t }}</span>
      </dt>
      <dd>
        <p class="text-sm font-bold text-text">{{ 'conditions.mp' | t }}</p>
        <p class="text-xs text-text opacity-60 mt-0.5">{{ 'conditions.mp_desc' | t }}</p>
      </dd>
    </div>
    <div class="flex gap-3 p-3 bg-background rounded">
      <dt class="flex-shrink-0 w-10">
        <span class="badge badge-error">{{ 'conditions.hp_abbr' | t }}</span>
      </dt>
      <dd>
        <p class="text-sm font-bold text-text">{{ 'conditions.hp' | t }}</p>
        <p class="text-xs text-text opacity-60 mt-0.5">{{ 'conditions.hp_desc' | t }}</p>
      </dd>
    </div>
    <div class="flex gap-3 p-3 bg-background rounded">
      <dt class="flex-shrink-0 w-10">
        <span class="badge badge-error">{{ 'conditions.dmg_abbr' | t }}</span>
      </dt>
      <dd>
        <p class="text-sm font-bold text-text">{{ 'conditions.dmg' | t }}</p>
        <p class="text-xs text-text opacity-60 mt-0.5">{{ 'conditions.dmg_desc' | t }}</p>
      </dd>
    </div>
  </dl>
</div>

{%- comment -%} Modal wrapper — shown/hidden by tcg-condition-modal.js {%- endcomment -%}
<div
  class="fixed inset-0 z-50 hidden items-center justify-center"
  data-condition-modal
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'conditions.guide_title' | t }}"
>
  <div class="fixed inset-0 bg-black/60" data-condition-modal-backdrop></div>
  <div class="relative bg-surface border border-border rounded-lg p-6 max-w-lg w-full mx-4 max-h-[80vh] overflow-y-auto z-10">
    <button
      type="button"
      class="absolute top-3 right-3 text-text opacity-40 hover:opacity-100 transition-opacity"
      data-condition-modal-close
      aria-label="{{ 'accessibility.close_modal' | t }}"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
      </svg>
    </button>
    <div data-condition-modal-content>
      {%- comment -%} Content cloned from above by JS {%- endcomment -%}
    </div>
  </div>
</div>
