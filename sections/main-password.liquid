<section class="py-section min-h-screen flex items-center justify-center">
  <div class="mx-auto max-w-md px-4 text-center">
    <h1 class="text-3xl font-heading font-bold text-text mb-2">{{ 'password.title' | t }}</h1>
    <p class="text-text/70 mb-8">{{ 'password.subtext' | t }}</p>

    {%- form 'customer' -%}
      <div class="flex gap-2">
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ 'password.email_placeholder' | t }}"
          required
          class="flex-1 px-4 py-3 bg-surface border border-border rounded text-text placeholder:text-text/50 focus:outline-none focus:border-primary"
        >
        <button type="submit" class="px-6 py-3 bg-primary text-white font-bold rounded hover:opacity-90 transition-opacity">
          {{ 'password.submit' | t }}
        </button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": []
}
{% endschema %}
