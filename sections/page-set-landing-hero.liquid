{%- liquid
  assign image = section.settings.banner_image
  assign heading = section.settings.heading | default: page.title
  assign subheading = section.settings.subheading
  assign release_date = section.settings.release_date
-%}

<section class="relative overflow-hidden" {{ section.shopify_attributes }}>
  {%- if image != blank -%}
    <div class="relative" style="min-height: 320px;">
      <img
        src="{{ image | image_url: width: 1920 }}"
        srcset="
          {{ image | image_url: width: 960 }} 960w,
          {{ image | image_url: width: 1440 }} 1440w,
          {{ image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt="{{ heading | escape }}"
        width="1920"
        height="{{ 1920 | divided_by: image.aspect_ratio | round }}"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      >
      <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-background/40 to-transparent"></div>
      <div class="relative flex items-end min-h-[320px] pb-8">
        <div class="mx-auto max-w-content px-4 text-center w-full">
          <h1 class="text-h1 font-heading font-bold text-white mb-3 drop-shadow-lg">{{ heading }}</h1>
          {%- if subheading != blank -%}
            <p class="text-lg text-white/80 mb-2">{{ subheading }}</p>
          {%- endif -%}
          {%- if release_date != blank -%}
            <p class="text-sm text-accent font-bold">Release: {{ release_date }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="py-section">
      <div class="mx-auto max-w-content px-4 text-center">
        <h1 class="text-h1 font-heading font-bold text-text mb-4">{{ heading }}</h1>
        {%- if subheading != blank -%}
          <p class="text-lg text-text opacity-70 mb-2">{{ subheading }}</p>
        {%- endif -%}
        {%- if release_date != blank -%}
          <p class="text-sm text-accent font-bold">Release: {{ release_date }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Set landing hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "release_date",
      "label": "Release date"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    }
  ],
  "presets": [
    {
      "name": "Set landing hero"
    }
  ]
}
{% endschema %}
