<section class="py-section">
  <div class="mx-auto max-w-content px-4 text-center">
    <h1 class="text-4xl font-heading font-bold text-text mb-4">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="text-lg text-text/70 mb-2">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.release_date != blank -%}
      <p class="text-sm text-accent">Release: {{ section.settings.release_date }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Set landing hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "release_date",
      "label": "Release date"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    }
  ],
  "presets": [
    {
      "name": "Set landing hero"
    }
  ]
}
{% endschema %}
