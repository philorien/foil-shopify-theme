{%- liquid
  assign image = section.settings.image
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign overlay = section.settings.overlay_opacity | default: 50
  assign text_align = section.settings.text_alignment | default: 'center'
  assign min_height = section.settings.min_height | default: 500
-%}

<section class="relative overflow-hidden" {{ section.shopify_attributes }}>
  {%- if image != blank -%}
    <div class="relative" style="min-height: {{ min_height }}px;">
      <img
        src="{{ image | image_url: width: 1920 }}"
        srcset="
          {{ image | image_url: width: 960 }} 960w,
          {{ image | image_url: width: 1440 }} 1440w,
          {{ image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt="{{ heading | default: shop.name | escape }}"
        width="1920"
        height="{{ 1920 | divided_by: image.aspect_ratio | round }}"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
      >
      <div class="absolute inset-0" style="background: rgba(0,0,0,{{ overlay | divided_by: 100.0 }});"></div>
    </div>
  {%- else -%}
    <div class="bg-gradient-to-br from-surface to-background" style="min-height: {{ min_height }}px;"></div>
  {%- endif -%}

  {%- comment -%} Content overlay {%- endcomment -%}
  <div class="absolute inset-0 flex items-center">
    <div class="mx-auto max-w-content px-4 w-full text-{{ text_align }}">
      {%- if heading != blank -%}
        <h2 class="text-h1 font-heading font-bold text-white mb-4 drop-shadow-lg">{{ heading }}</h2>
      {%- endif -%}
      {%- if subtext != blank -%}
        <p class="text-lg text-white/80 mb-8 max-w-2xl {% if text_align == 'center' %}mx-auto{% endif %}">
          {{ subtext }}
        </p>
      {%- endif -%}

      {%- comment -%} CTA buttons from blocks {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="flex flex-wrap gap-3 {% if text_align == 'center' %}justify-center{% elsif text_align == 'right' %}justify-end{% endif %}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'button' -%}
              <a
                href="{{ block.settings.link }}"
                class="{% if forloop.first %}btn btn-primary btn-lg{% else %}btn btn-ghost btn-lg border border-white/30 text-white hover:bg-white/10{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your local card shop"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Singles, sealed product, and accessories for every game."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
