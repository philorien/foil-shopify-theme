{%- liquid
  assign heading = section.settings.heading
  assign columns = section.settings.columns | default: 3
-%}

<section class="py-section" {{ section.shopify_attributes }}>
  <div class="mx-auto max-w-content px-4">
    {%- if heading != blank -%}
      <h2 class="text-h3 font-heading font-bold text-text mb-6">{{ heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="grid grid-cols-2 md:grid-cols-{{ columns }} gap-4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' -%}
            {%- assign coll = block.settings.collection -%}
            {%- if coll != blank -%}
              <a
                href="{{ coll.url }}"
                class="group relative block rounded overflow-hidden bg-surface border border-border hover:border-primary transition-colors"
                {{ block.shopify_attributes }}
              >
                {%- if coll.image or block.settings.custom_image != blank -%}
                  {%- assign coll_image = block.settings.custom_image | default: coll.image -%}
                  <img
                    src="{{ coll_image | image_url: width: 600 }}"
                    alt="{{ coll.title | escape }}"
                    width="600"
                    height="{{ 600 | divided_by: coll_image.aspect_ratio | round }}"
                    class="w-full aspect-[4/3] object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="w-full aspect-[4/3] bg-background"></div>
                {%- endif -%}
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-4">
                  <h3 class="text-lg font-heading font-bold text-white drop-shadow">{{ coll.title }}</h3>
                  <p class="text-xs text-white/70">{{ coll.products_count }} {{ 'collections.results_count' | t: count: '' | strip }}</p>
                </div>
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="text-text opacity-40 text-center py-8">Add collections in the theme editor</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image",
          "info": "Overrides the collection image"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
