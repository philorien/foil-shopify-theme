<section class="py-section">
  <div class="mx-auto max-w-content px-4">
    <h2 class="text-2xl font-heading font-bold text-text mb-6">{{ section.settings.heading | default: 'Browse by type' }}</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          <a
            href="{{ block.settings.collection.url }}"
            class="p-6 bg-surface border border-border rounded text-center hover:border-primary transition-colors"
            {{ block.shopify_attributes }}
          >
            <p class="font-heading font-bold text-text">{{ block.settings.label | default: block.settings.collection.title }}</p>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Set landing browse",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Browse by type"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Set landing browse"
    }
  ]
}
{% endschema %}
