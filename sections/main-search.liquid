<section class="py-section">
  <div class="mx-auto max-w-content px-4">
    <h1 class="text-3xl font-heading font-bold text-text mb-8">{{ 'search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="mb-8">
      <div class="flex gap-2">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          class="flex-1 px-4 py-3 bg-surface border border-border rounded text-text placeholder:text-text/50 focus:outline-none focus:border-primary"
        >
        <button type="submit" class="px-6 py-3 bg-primary text-white font-bold rounded hover:opacity-90 transition-opacity">
          {{ 'general.search' | t }}
        </button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <p class="text-sm text-text/50 mb-4">
          {{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}
              {%- render 'card-product', product: result -%}
            {%- else -%}
              <a href="{{ result.url }}" class="p-4 bg-surface border border-border rounded hover:border-primary transition-colors">
                <p class="text-xs text-text/50 uppercase mb-1">{{ result.object_type }}</p>
                <p class="font-bold text-text">{{ result.title }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="text-text/50">{{ 'search.no_results' | t: terms: search.terms }}</p>
        <p class="text-sm text-text/30 mt-1">{{ 'search.no_results_hint' | t }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "settings": []
}
{% endschema %}
