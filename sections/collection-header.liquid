<section class="py-section">
  <div class="mx-auto max-w-content px-4">
    <h1 class="text-3xl font-heading font-bold text-text mb-2">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="prose max-w-none text-text/70">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</section>

