<section class="py-section" {{ section.shopify_attributes }}>
  <div class="mx-auto max-w-content px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

      {%- comment -%} Left column — info {%- endcomment -%}
      <div>
        {%- if section.settings.heading != blank -%}
          <h1 class="text-h2 font-heading font-bold text-text mb-4">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.subtext != blank -%}
          <div class="prose max-w-none mb-8">
            {{ section.settings.subtext }}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="space-y-4">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'info_item' -%}
                  <div class="flex items-start gap-3" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon == 'email' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-0.5" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    {%- elsif block.settings.icon == 'phone' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    {%- elsif block.settings.icon == 'location' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    {%- elsif block.settings.icon == 'clock' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary flex-shrink-0 mt-0.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {%- endif -%}
                    <div>
                      {%- if block.settings.label != blank -%}
                        <p class="text-sm font-bold text-text">{{ block.settings.label }}</p>
                      {%- endif -%}
                      {%- if block.settings.value != blank -%}
                        <p class="text-sm text-text opacity-70">{{ block.settings.value }}</p>
                      {%- endif -%}
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right column — form {%- endcomment -%}
      <div class="bg-surface border border-border rounded p-6 lg:p-8">
        {%- form 'contact', id: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="bg-success/10 border border-success/30 rounded p-4 mb-6">
              <p class="text-sm text-success font-bold">{{ 'contact.success' | t }}</p>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="bg-error/10 border border-error/30 rounded p-4 mb-6">
              <p class="text-sm text-error font-bold mb-1">{{ 'contact.error' | t }}</p>
              <ul class="text-sm text-error list-disc list-inside">
                {%- for field in form.errors -%}
                  <li>{{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="space-y-4">
            <div>
              <label for="contact-name" class="block text-sm font-bold text-text mb-1">{{ 'contact.name' | t }}</label>
              <input
                type="text"
                id="contact-name"
                name="contact[{{ 'contact.name' | t }}]"
                autocomplete="name"
                required
                class="w-full bg-background border border-border rounded px-3 py-2 text-sm text-text placeholder:text-text/40 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
                placeholder="{{ 'contact.name_placeholder' | t }}"
              >
            </div>

            <div>
              <label for="contact-email" class="block text-sm font-bold text-text mb-1">{{ 'contact.email' | t }}</label>
              <input
                type="email"
                id="contact-email"
                name="contact[email]"
                autocomplete="email"
                required
                class="w-full bg-background border border-border rounded px-3 py-2 text-sm text-text placeholder:text-text/40 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
                placeholder="{{ 'contact.email_placeholder' | t }}"
              >
            </div>

            {%- if section.settings.show_phone -%}
              <div>
                <label for="contact-phone" class="block text-sm font-bold text-text mb-1">{{ 'contact.phone' | t }}</label>
                <input
                  type="tel"
                  id="contact-phone"
                  name="contact[{{ 'contact.phone' | t }}]"
                  autocomplete="tel"
                  class="w-full bg-background border border-border rounded px-3 py-2 text-sm text-text placeholder:text-text/40 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
                  placeholder="{{ 'contact.phone_placeholder' | t }}"
                >
              </div>
            {%- endif -%}

            {%- if section.settings.show_subject -%}
              <div>
                <label for="contact-subject" class="block text-sm font-bold text-text mb-1">{{ 'contact.subject' | t }}</label>
                <select
                  id="contact-subject"
                  name="contact[{{ 'contact.subject' | t }}]"
                  class="w-full bg-background border border-border rounded px-3 py-2 text-sm text-text focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
                >
                  <option value="">{{ 'contact.subject_placeholder' | t }}</option>
                  <option value="{{ 'contact.subject_order' | t }}">{{ 'contact.subject_order' | t }}</option>
                  <option value="{{ 'contact.subject_product' | t }}">{{ 'contact.subject_product' | t }}</option>
                  <option value="{{ 'contact.subject_buylist' | t }}">{{ 'contact.subject_buylist' | t }}</option>
                  <option value="{{ 'contact.subject_events' | t }}">{{ 'contact.subject_events' | t }}</option>
                  <option value="{{ 'contact.subject_other' | t }}">{{ 'contact.subject_other' | t }}</option>
                </select>
              </div>
            {%- endif -%}

            <div>
              <label for="contact-message" class="block text-sm font-bold text-text mb-1">{{ 'contact.message' | t }}</label>
              <textarea
                id="contact-message"
                name="contact[{{ 'contact.message' | t }}]"
                rows="5"
                required
                class="w-full bg-background border border-border rounded px-3 py-2 text-sm text-text placeholder:text-text/40 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors resize-y"
                placeholder="{{ 'contact.message_placeholder' | t }}"
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-full">
              {{ 'contact.submit' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Description",
      "default": "<p>Have a question about an order, want to sell your cards, or looking for a specific card? Drop us a message and we'll get back to you.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone field",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_subject",
      "label": "Show subject dropdown",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "info_item",
      "name": "Contact info",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "email", "label": "Email" },
            { "value": "phone", "label": "Phone" },
            { "value": "location", "label": "Location" },
            { "value": "clock", "label": "Hours" }
          ],
          "default": "email"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Email"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "info@yourstore.com"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        {
          "type": "info_item",
          "settings": { "icon": "email", "label": "Email", "value": "info@yourstore.com" }
        },
        {
          "type": "info_item",
          "settings": { "icon": "location", "label": "Store", "value": "123 Main St, Your City" }
        },
        {
          "type": "info_item",
          "settings": { "icon": "clock", "label": "Hours", "value": "Mon–Sat 11am–7pm, Sun 12–5pm" }
        }
      ]
    }
  ]
}
{% endschema %}
