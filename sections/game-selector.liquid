{%- liquid
  assign heading = section.settings.heading
-%}

<section class="py-section" {{ section.shopify_attributes }}>
  <div class="mx-auto max-w-content px-4">
    {%- if heading != blank -%}
      <h2 class="text-h3 font-heading font-bold text-text mb-6 text-center">{{ heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-{{ section.blocks.size | at_most: 6 }} gap-4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'game' -%}
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="group relative block rounded-lg overflow-hidden bg-surface border border-border hover:border-primary transition-all hover:scale-[1.02]"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  alt="{{ block.settings.label | default: 'Game' | escape }}"
                  width="400"
                  height="400"
                  class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                >
              {%- else -%}
                <div class="w-full aspect-square bg-background flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-border" aria-hidden="true">
                    <path d="M6 4H18A2 2 0 0 1 20 6V18A2 2 0 0 1 18 20H6A2 2 0 0 1 4 18V6A2 2 0 0 1 6 4Z"/>
                    <path d="M12 8v8"/><path d="M8 12h8"/>
                  </svg>
                </div>
              {%- endif -%}
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-3 text-center">
                <h3 class="text-base font-heading font-bold text-white drop-shadow">
                  {{ block.settings.label | default: 'Game' }}
                </h3>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="text-text opacity-40 text-center py-8">Add games in the theme editor</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Game selector",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by game"
    }
  ],
  "blocks": [
    {
      "type": "game",
      "name": "Game",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Game name",
          "default": "Game"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Game image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Game selector",
      "blocks": [
        { "type": "game", "settings": { "label": "Magic: The Gathering" } },
        { "type": "game", "settings": { "label": "Pok\u00e9mon" } },
        { "type": "game", "settings": { "label": "Yu-Gi-Oh!" } },
        { "type": "game", "settings": { "label": "One Piece" } },
        { "type": "game", "settings": { "label": "Lorcana" } }
      ]
    }
  ]
}
{% endschema %}
