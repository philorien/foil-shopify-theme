<section class="py-section">
  <div class="mx-auto max-w-2xl px-4">
    <h2 class="text-2xl font-heading font-bold text-text mb-4">{{ section.settings.heading | default: 'buylist.policy_title' | t }}</h2>
    <div class="prose max-w-none text-text/70">
      {{ section.settings.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Buylist policy",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buylist pricing policy"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Policy content"
    }
  ],
  "presets": [
    {
      "name": "Buylist policy"
    }
  ]
}
{% endschema %}
