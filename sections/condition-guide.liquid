<section class="py-section" {{ section.shopify_attributes }}>
  <div class="mx-auto max-w-content px-4">
    {%- if section.settings.heading != blank -%}
      <h2 class="text-h3 font-heading font-bold text-text mb-6">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="prose max-w-none mb-8">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    {%- render 'condition-guide' -%}
  </div>
</section>

{% schema %}
{
  "name": "Condition guide",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Card condition guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We grade every card we sell using industry-standard condition categories. Here's what each grade means so you know exactly what to expect.</p>"
    }
  ],
  "presets": [
    {
      "name": "Condition guide"
    }
  ]
}
{% endschema %}
